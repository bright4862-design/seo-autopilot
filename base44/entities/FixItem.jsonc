{
  "name": "FixItem",
  "type": "object",
  "properties": {
    "fix_list_id": {
      "type": "string"
    },
    "scan_run_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "fix_id": {
      "type": "string"
    },
    "rule": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "customer_category": {
      "type": "string"
    },
    "issue_title": {
      "type": "string"
    },
    "plain_english_explanation": {
      "type": "string"
    },
    "why_it_matters": {
      "type": "string"
    },
    "current_value": {
      "type": "string"
    },
    "recommended_value": {
      "type": "string"
    },
    "simple_next_step": {
      "type": "string"
    },
    "page_scope": {
      "type": "string",
      "enum": [
        "page",
        "family",
        "cross_cutting",
        "sitewide"
      ]
    },
    "page_template_family": {
      "type": "string"
    },
    "page_url": {
      "type": "string"
    },
    "affected_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "source_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_status": {
      "type": "string"
    },
    "verification_state": {
      "type": "string"
    },
    "limitation_code": {
      "type": "string"
    },
    "confidence_score": {
      "type": "number",
      "default": 0
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "difficulty": {
      "type": "string"
    },
    "who_can_do_this": {
      "type": "string"
    },
    "requires_developer": {
      "type": "boolean",
      "default": false
    },
    "requires_approval": {
      "type": "boolean",
      "default": false
    },
    "can_auto_fix": {
      "type": "boolean",
      "default": false
    },
    "estimated_time": {
      "type": "string"
    },
    "user_status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "done",
        "dismissed"
      ],
      "default": "open"
    },
    "completed_at": {
      "type": "string"
    },
    "completed_by_user_id": {
      "type": "string"
    },
    "first_seen_scan_run_id": {
      "type": "string"
    },
    "carried_over": {
      "type": "boolean",
      "default": false
    },
    "raw_finding": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "owner_user_id": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "page_count": {
      "type": "number",
      "default": 0
    },
    "family_breakdown": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "representative_pages_by_family": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "what_to_do_steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "metadata_state_counts": {
      "type": "object",
      "additionalProperties": true,
      "default": {
        "missing": 0,
        "empty": 0,
        "malformed": 0
      }
    },
    "combined_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "grouping_explanation": {
      "type": "string"
    },
    "authority_proof": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "repair_contract_version": {
      "type": "string"
    },
    "repair_snapshot_contract_version": {
      "type": "string"
    },
    "repair_snapshot_contract_complete": {
      "type": "boolean",
      "default": false
    },
    "repair_priority_model_version": {
      "type": "string"
    },
    "base_severity": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "technical_severity_source": {
      "type": "string"
    },
    "evidence_class": {
      "type": "string",
      "enum": [
        "confirmed_problem",
        "improvement",
        "opportunity"
      ]
    },
    "action_priority": {
      "type": "string",
      "enum": [
        "fix_first",
        "important",
        "improve",
        "review"
      ]
    },
    "action_priority_score": {
      "type": "number",
      "default": 0
    },
    "priority_reason": {
      "type": "string"
    },
    "canonical_action_rank": {
      "type": "number",
      "default": 0
    },
    "repair_identity_version": {
      "type": "string"
    },
    "repair_fingerprint": {
      "type": "string"
    },
    "repair_identity_state": {
      "type": "string"
    },
    "repair_identity_stable": {
      "type": "boolean",
      "default": false
    },
    "repair_surface": {
      "type": "string"
    },
    "remediation_family": {
      "type": "string"
    },
    "shared_repair_confirmed": {
      "type": "boolean",
      "default": false
    },
    "priority_context": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "repair_verification_state": {
      "type": "string"
    },
    "rule_definition_version": {
      "type": "string"
    },
    "comparison_profile_version": {
      "type": "string"
    }
  },
  "required": [
    "fix_list_id",
    "scan_run_id",
    "project_id",
    "issue_title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
