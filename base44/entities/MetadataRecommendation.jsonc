{
  "name": "MetadataRecommendation",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "page_url": {
      "type": "string"
    },
    "current_title": {
      "type": "string"
    },
    "recommended_title_1": {
      "type": "string"
    },
    "recommended_title_2": {
      "type": "string"
    },
    "recommended_title_3": {
      "type": "string"
    },
    "current_meta_description": {
      "type": "string"
    },
    "recommended_description_1": {
      "type": "string"
    },
    "recommended_description_2": {
      "type": "string"
    },
    "recommended_description_3": {
      "type": "string"
    },
    "suggested_h1": {
      "type": "string"
    },
    "suggested_slug": {
      "type": "string"
    },
    "suggested_faq_ideas": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "owner_user_id": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "page_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}