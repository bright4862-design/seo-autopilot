{
  "name": "GrokMessage",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "conversation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scan_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "normalized_domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "release_fingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "role": {
      "type": "string",
      "enum": ["user", "assistant"]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "model": {
      "type": "string",
      "maxLength": 160
    },
    "grok_chat_version": {
      "type": "string",
      "maxLength": 160
    }
  },
  "required": [
    "owner_user_id",
    "conversation_id",
    "project_id",
    "scan_run_id",
    "normalized_domain",
    "release_fingerprint",
    "role",
    "content",
    "sequence"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
