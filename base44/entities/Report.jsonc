{
  "name": "Report",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "crawl_job_id": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "fixed_count": {
      "type": "number",
      "default": 0
    },
    "approval_count": {
      "type": "number",
      "default": 0
    },
    "developer_count": {
      "type": "number",
      "default": 0
    },
    "competitor_summary": {
      "type": "string"
    },
    "next_steps": {
      "type": "string"
    },
    "seo_score": {
      "type": "number",
      "default": 0
    },
    "owner_user_id": {
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}