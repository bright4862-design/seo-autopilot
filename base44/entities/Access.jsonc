{
  "name": "Access",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "access_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "revoked"
      ],
      "default": "pending"
    },
    "plan_id": {
      "type": "string"
    },
    "grant_source": {
      "type": "string"
    },
    "app_id": {
      "type": "string"
    },
    "has_full_access": {
      "type": "boolean",
      "default": false
    },
    "paid_at": {
      "type": "string"
    },
    "granted_at": {
      "type": "string"
    },
    "stripe_checkout_session_id": {
      "type": "string"
    },
    "stripe_payment_intent_id": {
      "type": "string"
    },
    "stripe_event_id": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "owner_user_id": "{{user.id}}"
        },
        {
          "user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
