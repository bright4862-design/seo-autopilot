{
  "name": "Access",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "scans_used": {
      "type": "number",
      "default": 0
    },
    "has_full_access": {
      "type": "boolean",
      "default": false
    },
    "paid_at": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "access_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "revoked"
      ]
    },
    "plan_id": {
      "type": "string"
    },
    "app_id": {
      "type": "string"
    },
    "grant_source": {
      "type": "string",
      "enum": [
        "stripe_checkout",
        "owner_test"
      ]
    },
    "stripe_checkout_session_id": {
      "type": "string"
    },
    "granted_at": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}