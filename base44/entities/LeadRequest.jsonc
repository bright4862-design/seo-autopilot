{
  "name": "LeadRequest",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "waitlist",
        "cleanup",
        "custom_rebuild"
      ]
    },
    "selected_plan": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "scan_summary": {
      "type": "object",
      "properties": {
        "health_score": {
          "type": "number"
        },
        "prepared_fixes": {
          "type": "number"
        },
        "needs_approval": {
          "type": "number"
        },
        "needs_developer": {
          "type": "number"
        }
      }
    },
    "selected_help_options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "closed"
      ],
      "default": "new"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "request_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}