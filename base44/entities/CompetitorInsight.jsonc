{
  "name": "CompetitorInsight",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "competitor_id": {
      "type": "string"
    },
    "competitor_url": {
      "type": "string"
    },
    "insight_title": {
      "type": "string"
    },
    "explanation": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "impact": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "insight_title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}