{
  "name": "BusinessProject",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "business_type": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "service_area": {
      "type": "string"
    },
    "main_services": {
      "type": "string"
    },
    "important_keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "scan_mode": {
      "type": "string",
      "enum": [
        "quick",
        "deep"
      ],
      "default": "quick"
    },
    "cms_platform": {
      "type": "string",
      "enum": [
        "WordPress",
        "Shopify",
        "Wix",
        "Webflow",
        "Squarespace",
        "Custom",
        "Unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "setup",
        "active",
        "paused",
        "archived"
      ],
      "default": "setup"
    },
    "seo_score": {
      "type": "number",
      "default": 0
    },
    "last_crawl_at": {
      "type": "string"
    },
    "next_crawl_at": {
      "type": "string"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "free",
        "diy",
        "growth",
        "done_for_you",
        "rebuild"
      ],
      "default": "free"
    },
    "owner_user_id": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "website_url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}