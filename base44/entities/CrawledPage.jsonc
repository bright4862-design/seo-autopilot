{
  "name": "CrawledPage",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "crawl_job_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "status_code": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "h1": {
      "type": "string"
    },
    "canonical_url": {
      "type": "string"
    },
    "word_count": {
      "type": "number",
      "default": 0
    },
    "indexable": {
      "type": "boolean",
      "default": true
    },
    "in_sitemap": {
      "type": "boolean",
      "default": false
    },
    "rendered_title": {
      "type": "string"
    },
    "rendered_meta_description": {
      "type": "string"
    },
    "rendered_canonical": {
      "type": "string"
    },
    "js_difference_detected": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_id",
    "crawl_job_id",
    "url"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}