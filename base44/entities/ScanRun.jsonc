{
  "name": "ScanRun",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Owner-scoped request identity used for replay protection."
    },
    "idempotency_key": {
      "type": "string",
      "description": "Must equal request_id for the Standard scan path."
    },
    "request_fingerprint": {
      "type": "string",
      "description": "Normalized scan mode and target used to reject conflicting replays."
    },
    "scan_id": {
      "type": "string",
      "description": "Canonical scan identity; set to this entity record's server-generated id."
    },
    "project_id": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "submitted_url": {
      "type": "string"
    },
    "final_url": {
      "type": "string"
    },
    "normalized_domain": {
      "type": "string"
    },
    "path_prefix": {
      "type": "string"
    },
    "scope_type": {
      "type": "string",
      "enum": ["", "path_prefix"],
      "default": "",
      "description": "Focused-scan scope type. This release supports same-origin path_prefix only."
    },
    "parent_scan_id": {
      "type": "string",
      "description": "Full-site ScanRun that discovered and authorized this focused section."
    },
    "requested_origin": {
      "type": "string",
      "description": "Canonical same-origin authority boundary for a focused scan."
    },
    "requested_path_prefix": {
      "type": "string",
      "description": "Normalized path prefix requested for this focused scan."
    },
    "effective_path_prefix": {
      "type": "string",
      "description": "Actual path prefix enforced by the worker after any verified same-origin scope adjustment."
    },
    "discovered_from": {
      "type": "string",
      "enum": ["", "sitemap", "internal_link", "canonical", "hreflang"],
      "default": ""
    },
    "user_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "True only when the customer explicitly chose the discovered section."
    },
    "scan_mode": {
      "type": "string",
      "enum": [
        "standard_150",
        "basic",
        "quick",
        "deep",
        "advanced"
      ],
      "default": "standard_150",
      "description": "New customer scans use standard_150. Legacy values remain valid so historical scan records stay readable."
    },
    "scan_source": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "crawling",
        "reviewing",
        "complete",
        "limited",
        "failed",
        "cancelled"
      ],
      "default": "queued"
    },
    "status_detail": {
      "type": "string"
    },
    "scanner_version": {
      "type": "string"
    },
    "scanner_build_revision": {
      "type": "string"
    },
    "scanner_wrapper_version": {
      "type": "string"
    },
    "release_id": {
      "type": "string",
      "description": "Composite scanner version/build/beta fingerprint identity."
    },
    "advanced_scan_backend": {
      "type": "string"
    },
    "deno_fallback_used": {
      "type": "boolean",
      "default": false
    },
    "archetype_classifier_version": {
      "type": "string"
    },
    "review_version": {
      "type": "string"
    },
    "review_evidence_calibration_version": {
      "type": "string"
    },
    "ai_review_backend": {
      "type": "string"
    },
    "python_review_fallback_used": {
      "type": "boolean",
      "default": false
    },
    "release_gate_eligible": {
      "type": "boolean",
      "default": false
    },
    "beta_revision_fingerprint": {
      "type": "string"
    },
    "metadata_evidence_version": {
      "type": "string"
    },
    "title_evidence_version": {
      "type": "string"
    },
    "pages_found": {
      "type": "number",
      "default": 0
    },
    "pages_crawled": {
      "type": "number",
      "default": 0
    },
    "pages_retained": {
      "type": "number",
      "default": 0
    },
    "local_cache_complete": {
      "type": "boolean",
      "default": false
    },
    "queued_remaining": {
      "type": "number",
      "default": 0
    },
    "sampling_evidence": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "crawl_timing": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "scan_status": {
      "type": "string"
    },
    "review_confidence_state": {
      "type": "string"
    },
    "score_is_provisional": {
      "type": "boolean",
      "default": false
    },
    "access_evidence_state": {
      "type": "string"
    },
    "evidence_quality_state": {
      "type": "string"
    },
    "evidence_quality_score": {
      "type": "number",
      "default": 0
    },
    "evidence_quality_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "discovery_quality_state": {
      "type": "string"
    },
    "representative_html_page_count": {
      "type": "number",
      "default": 0
    },
    "usable_html_page_count": {
      "type": "number",
      "default": 0
    },
    "default_route_page_count": {
      "type": "number",
      "default": 0
    },
    "evidence_quality_blocking": {
      "type": "boolean",
      "default": false
    },
    "evidence_quality_gate_version": {
      "type": "string"
    },
    "coverage_authority_evidence_version": {
      "type": "string",
      "description": "Version of the coverage/inventory assessment sealed with this scan."
    },
    "coverage_authority_evidence": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Diagnostic record of how much of the site the crawl saw and whether anything positively established the site's size. Does not participate in authority."
    },
    "coverage_state": {
      "type": "string",
      "description": "Coverage verdict bound into a verified limited result."
    },
    "coverage_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Bounded reasons supporting a verified limited-result coverage verdict."
    },
    "coverage_authority_version": {
      "type": "string",
      "description": "Version of the shared coverage decision used for a limited result."
    },
    "classification_integrity": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Reviewed classifier verdict and evidence sufficiency bound into the result proof."
    },
    "classification_verdict": {
      "type": "string",
      "description": "Customer-safe state copied from classification_integrity for release acceptance."
    },
    "peak_memory_bytes": {
      "type": "number",
      "description": "Measured peak resident worker memory for this concurrency-one Standard 150 job."
    },
    "worker_peak_memory_bytes": {
      "type": "number",
      "description": "Measured peak resident worker memory including the isolated review child."
    },
    "no_high_confidence_findings": {
      "type": "boolean",
      "default": false
    },
    "limitation": {
      "type": "string"
    },
    "render_evidence": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "health_score": {
      "type": "number"
    },
    "health_grade": {
      "type": "string"
    },
    "customer_summary": {
      "type": "string"
    },
    "next_best_step": {
      "type": "string"
    },
    "fix_list_id": {
      "type": "string"
    },
    "previous_scan_id": {
      "type": "string"
    },
    "rescan_of_scan_id": {
      "type": "string"
    },
    "attempt_count": {
      "type": "number",
      "default": 1
    },
    "admission_access_id": {
      "type": "string",
      "description": "Durable server-owned Access entitlement provenance for the admitted scan. This is not coordinator lease state and is never cleared."
    },
    "admission_claim_token": {
      "type": "string",
      "description": "Reserved legacy field. New admission paths never persist the coordinator bearer claim token."
    },
    "admission_barrier_generation": {
      "type": "number",
      "description": "Server-owned global claim-barrier generation returned by the coordinator for this admitted request.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_claim_sequence": {
      "type": "number",
      "description": "Server-owned monotonic coordinator claim sequence used to prove that another request generation is newer.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_mode": {
      "type": "string",
      "enum": [
        "open",
        "acceptance_only"
      ],
      "description": "Server-owned coordinator admission mode under which the request was claimed.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_acceptance_cohort_id": {
      "type": "string",
      "description": "Server-owned acceptance cohort identifier; empty for ordinary public claims.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_acceptance_release_id": {
      "type": "string",
      "description": "Immutable release identity attached by the coordinator to an acceptance-only claim.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_acceptance_source_sha": {
      "type": "string",
      "description": "Exact source SHA attached by the coordinator to an acceptance-only claim.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_acceptance_expires_at": {
      "type": "number",
      "description": "Immutable Unix expiry for the server-authorized acceptance-only cohort claim.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_cohort_evidence_version": {
      "type": "string",
      "description": "Version of the coordinator-signed acceptance cohort evidence attached to this claim.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_cohort_evidence_proof": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "description": "Coordinator HMAC proof binding the immutable server-derived acceptance cohort evidence.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_release_state": {
      "type": "string",
      "enum": [
        "pending",
        "released",
        "superseded",
        "satisfied_unbound"
      ],
      "description": "Server-owned reconciliation state for the coordinator generation associated with this scan. A missing value on a legacy server-admitted row is treated as pending.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_release_reconciled_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-owned time at which an exact coordinator release obligation was durably satisfied.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_release_last_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "Server-owned time of the latest bounded reconciliation attempt, used for starvation-free retry rotation.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_release_coordinator_request_id": {
      "type": "string",
      "description": "Sanitized coordinator request generation observed when the release obligation was reconciled.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_release_outcome": {
      "type": "string",
      "description": "Sanitized closed-set coordinator or reconciliation outcome; never contains an upstream response body.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_release_failure_code": {
      "type": "string",
      "description": "Sanitized retryable coordinator failure code for operator diagnostics; contains no secret material.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "admission_reconciliation_version": {
      "type": "string",
      "description": "Generated release-contract marker identifying the durable admission reconciliation implementation.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "resumable": {
      "type": "boolean",
      "default": false
    },
    "resume_token": {
      "type": "string"
    },
    "error_code": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "cancelled_reason": {
      "type": "string"
    },
    "respect_robots_txt": {
      "type": "boolean",
      "default": true
    },
    "queued_at": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "worker_heartbeat_at": {
      "type": "string",
      "description": "Server-owned liveness timestamp refreshed when the durable worker starts, retries, or finishes its crawl handoff.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "reviewing_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "authority_seal_version": {
      "type": "string",
      "description": "Server-only HMAC evidence contract version. Browser-created scans remain unsealed.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "authority_sealed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Time the trusted review snapshot was persisted by persistScanAuthority.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "authority_proof": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$",
      "description": "HMAC-SHA256 proof binding the ScanRun, FixList, and FixItems consumed by Grok.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "owner_user_id": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "result_integrity_version": {
      "type": "string",
      "description": "Version of the limited-result integrity contract, when this row is a verified limited result."
    },
    "result_integrity_domain": {
      "type": "string",
      "description": "HMAC domain label bound into the limited-result proof. Never an authority domain."
    },
    "result_integrity_sealed_at": {
      "type": "string",
      "description": "Stable timestamp bound into the limited-result proof, so a retry reproduces it."
    },
    "result_integrity_proof": {
      "type": "string",
      "description": "Server-only HMAC over the limited result. Cryptographically unusable as an authority proof."
    }
  },
  "required": [
    "project_id",
    "website_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
