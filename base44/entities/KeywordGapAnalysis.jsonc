{
  "name": "KeywordGapAnalysis",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "keyword": {
      "type": "string"
    },
    "customer_page_url": {
      "type": "string"
    },
    "competitor_page_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "common_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_title": {
      "type": "string"
    },
    "recommended_meta_description": {
      "type": "string"
    },
    "recommended_headings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_faqs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust_signal_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "call_to_action_recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "completed"
      ],
      "default": "open"
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "keyword"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}