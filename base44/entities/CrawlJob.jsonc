{
  "name": "CrawlJob",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "reading_sitemap",
        "crawling_html",
        "checking_links",
        "rendering_js",
        "checking_metadata",
        "checking_canonicals",
        "checking_sitemap",
        "checking_redirects",
        "finding_competitors",
        "benchmarking_competitors",
        "generating_recommendations",
        "complete",
        "failed"
      ],
      "default": "queued"
    },
    "crawl_type": {
      "type": "string",
      "enum": [
        "full",
        "deep",
        "monthly",
        "competitor",
        "js_render"
      ],
      "default": "full"
    },
    "pages_found": {
      "type": "number",
      "default": 0
    },
    "pages_crawled": {
      "type": "number",
      "default": 0
    },
    "js_pages_rendered": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string"
    },
    "completed_at": {
      "type": "string"
    },
    "error_message": {
      "type": "string"
    },
    "seo_score": {
      "type": "number"
    },
    "issues_found": {
      "type": "number"
    },
    "owner_user_id": {
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}