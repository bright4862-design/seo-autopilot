{
  "name": "Access",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "scans_used": {
      "type": "number",
      "default": 0
    },
    "has_full_access": {
      "type": "boolean",
      "default": false
    },
    "paid_at": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}